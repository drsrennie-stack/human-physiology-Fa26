From ad71ebeeb12e8d3dfe0ff80aa79bfa5623d1ef0d Mon Sep 17 00:00:00 2001
From: "Dr. Sharilyn Rennie" <dr.srennie@gmail.com>
Date: Sun, 23 Aug 2026 18:29:47 +0000
Subject: [PATCH] Fix the blank band on every cover page

.coverpage carried min-height:70vh with justify-content:flex-end, so on
screen the title sat at the bottom of a 70 percent viewport block and
students met roughly 700px of white before any content. The print rule
overrides it with height:11in for a real cover page, so only the screen
rule needed changing: min-height:0 and a small top padding.

Ten pages affected: week-01, unit-01 through unit-05, unit-05-standalone,
anatomy-review, before-you-start, competency-study-guide.
---
 anatomy-review.html         | 2 +-
 before-you-start.html       | 2 +-
 competency-study-guide.html | 2 +-
 unit-01.html                | 2 +-
 unit-02.html                | 2 +-
 unit-03.html                | 2 +-
 unit-04.html                | 2 +-
 unit-05-standalone.html     | 2 +-
 unit-05.html                | 2 +-
 week-01.html                | 2 +-
 10 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/anatomy-review.html b/anatomy-review.html
index f5c4f94..9b9d198 100644
--- a/anatomy-review.html
+++ b/anatomy-review.html
@@ -95,7 +95,7 @@
   .navcta-alt:hover{border-color:var(--maroon-dark);background:var(--offwhite)}
 
   /* ---------- COVER PAGE ---------- */
-  .coverpage{display:flex;flex-direction:column;justify-content:flex-end;min-height:70vh;padding:0 0 0;margin:0 0 40px;position:relative}
+  .coverpage{display:flex;flex-direction:column;justify-content:flex-end;min-height:0;padding:6px 0 0;margin:0 0 40px;position:relative}
   .coverpage .mark{width:82px;margin:0 0 26px}
   .coverpage .mark svg{width:100%;height:auto;display:block}
   .coverpage .cp-eyebrow{font-family:var(--font-eyebrow);font-size:.72rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--maroon);margin:0 0 12px}
